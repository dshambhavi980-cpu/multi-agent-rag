# Application
APP_ENVIRONMENT=local
APP_APP_VERSION=0.1.0
APP_GIT_SHA=development
APP_LOG_LEVEL=INFO
APP_DOCS_ENABLED=true
APP_CORS_ORIGINS=["http://localhost:5173"]
APP_COLD_START_WINDOW_SECONDS=60

# Frontend
VITE_API_BASE_URL=/api
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase backend. The publishable key is safe for public clients.
APP_SUPABASE_URL=
APP_SUPABASE_PUBLISHABLE_KEY=
# Server-side deployment secret only. Never prefix this with VITE_.
APP_SUPABASE_SERVICE_ROLE_KEY=
APP_SUPABASE_JWKS_CACHE_SECONDS=600
APP_SUPABASE_HTTP_TIMEOUT_SECONDS=3
APP_INGESTION_WORKER_ENABLED=true
APP_INGESTION_POLL_SECONDS=1
APP_INGESTION_VISIBILITY_SECONDS=120
APP_INGESTION_BATCH_SIZE=2
APP_INGESTION_PARSE_TIMEOUT_SECONDS=45
APP_INDEX_STRATEGY=heading_recursive
APP_INDEX_TARGET_CHARS=1800
APP_INDEX_OVERLAP_CHARS=0
APP_INDEX_VERSION=1
APP_EMBEDDING_BATCH_SIZE=16
APP_EMBEDDING_DIMENSIONS=768
APP_EMBEDDING_TIMEOUT_SECONDS=30
APP_EMBEDDING_MAX_RETRIES=2
APP_EMBEDDING_RETRY_BASE_SECONDS=1
APP_QUERY_EMBEDDING_CACHE_TTL_SECONDS=86400
APP_RETRIEVAL_CACHE_TTL_SECONDS=900
APP_RETRIEVAL_RRF_K=60
APP_RETRIEVAL_DENSE_WEIGHT=1
APP_RETRIEVAL_SPARSE_WEIGHT=1
APP_RETRIEVAL_DUPLICATE_THRESHOLD=0.92
APP_RAG_EVIDENCE_LIMIT=6
APP_RAG_CANDIDATE_COUNT=30
APP_RAG_TIMEOUT_SECONDS=45
APP_RAG_INSUFFICIENT_SEMANTIC_THRESHOLD=0.25
APP_RAG_EVENT_POLL_SECONDS=0.1
APP_RAG_HEARTBEAT_SECONDS=15
APP_GENERATION_TIMEOUT_SECONDS=30
APP_GENERATION_MAX_RETRIES=1
APP_GENERATION_RETRY_BASE_SECONDS=0.5
APP_GENERATION_MAX_OUTPUT_TOKENS=1024

DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
